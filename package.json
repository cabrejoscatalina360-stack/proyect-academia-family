{
  "name": "uniciencia-academia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "start": "npm run dev -- --port 5173 --strictPort",
    "test:standalone": "npm run build:standalone && node scripts/verify-standalone.mjs",
    "deploy:pages": "npm run build:standalone && node scripts/publish-pages.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "lucide": "^1.71.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "vite": "^8.3.7"
  }
}
